# Application Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./src/database/app.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/blockguardian

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# External API Keys (optional)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key
INFURA_API_KEY=your-infura-key
ETHERSCAN_API_KEY=your-etherscan-key
COINMARKETCAP_API_KEY=your-coinmarketcap-key
POLYGON_API_KEY=your-polygon-key

# Blockchain Integration (optional - read-only)
# Points at the code/blockchain package's deployed contracts. Leave unset to
# run the backend without blockchain features; /api/blockchain/* endpoints
# will report "connected": false instead of failing. When running via
# `docker compose --profile blockchain up`, these are already set for you in
# code/docker-compose.yml - only needed here for running the backend outside
# Docker against a local `npx hardhat node`.
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_DEPLOYMENTS_DIR=../blockchain/deployments

# Monitoring Configuration (optional)
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
