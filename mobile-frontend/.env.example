# Backend API Configuration
# Base URL of the Flask backend (code/backend). No trailing slash.
# Use your machine's LAN IP (not localhost) when testing on a physical device,
# e.g. EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_API_BASE_PATH=/api

# App Configuration
EXPO_PUBLIC_APP_NAME=BlockGuardian
